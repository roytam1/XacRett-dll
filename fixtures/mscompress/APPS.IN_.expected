; This is an example
;
XYZAPP.exe  = xyzapp  ,"XYZ - Example APP"            ,Param   ,        ,345  ,cwe, ,1 ,        ,        ,xyzamb  ,xyzopt

[xyzamb]
XYZAPP.exe  = xyzapp  ,"XYZ - 1st Conflicting APP"    ,Param   ,        ,345  ,cwe, ,2 ,        ,        ,        ,
XYZAPP.exe  = xyzapp  ,"XYZ - 2nd Conflicting APP"    ,Param   ,        ,345  ,cwe, ,3 ,        ,        ,        ,xyz2opt
XYZAPP.exe  = xyzapp  ,"XYZ - 3rd Conflicting APP"    ,Param   ,        ,345  ,cwe, ,4 ,        ,        ,        ,

[xyzopt]
XYZAPP.exe  = xyzapp  ,"XYZ - Example APP, 1st Opt."  ,Param   ,        ,345  ,cwe, ,1 ,        ,        ,        ,
XYZAPP.exe  = xyzapp  ,"XYZ - Example APP, 2nd Opt."  ,Param   ,        ,345  ,cwe, ,3 ,        ,        ,        ,
XYZAPP.exe  = xyzapp  ,"XYZ - Example APP, 3rd Opt."  ,Param   ,        ,345  ,cwe, ,4 ,        ,        ,        ,

[xyz2opt]
XYZAPP.exe  = xyzapp  ,"XYZ - 2nd Conflict,1st Opt."  ,Param   ,        ,345  ,cwe, ,1 ,        ,        ,        ,
XYZAPP.exe  = xyzapp  ,"XYZ - 2nd Conflict,2nd Opt."  ,Param   ,        ,345  ,cwe, ,2 ,        ,        ,        ,
XYZAPP.exe  = xyzapp  ,"XYZ - 2nd Conflict,3rd Opt."  ,Param   ,        ,345  ,cwe, ,3 ,        ,        ,        ,
XYZAPP.exe  = xyzapp  ,"XYZ - 2nd Conflict,4th Opt."  ,Param   ,        ,345  ,cwe, ,4 ,        ,        ,        ,
XYZAPP.exe  = xyzapp  ,"XYZ - 2nd Conflict,5th Opt."  ,Param   ,        ,345  ,cwe, ,5 ,        ,        ,        ,
XYZAPP.exe  = xyzapp  ,"XYZ - 2nd Conflict,6th Opt."  ,Param   ,        ,345  ,cwe, ,6 ,        ,        ,        ,

[g286]
; graphics mode app but doesn't directly modify COM ports
videomode= gra
xmsmem= 0,0

[c286]
; text mode app which directly modifies COM ports
videomode= txt
xmsmem= 0,0
checkboxes= c1,c2,c3,c4

[gc286]
; graphics mode app which directly modifies COM ports
videomode= gra
xmsmem= 0,0
checkboxes= c1,c2,c3,c4

[dflt286sect]
; default is text mode app which does not directly modify COM ports
;
; Other Possible options are given for reference 
; ( (or) means entry corresponds to radio button group)
;
videomode   = txt    ; (or) gra
xmsmem      = 0,0    ; ##,, ## (min, max)
checkboxes  =        ; c1,c2,c3,c4,kbd,nse,pps,ata,aes,ces,psc,aps,nss

[np386]
; does not allow fast paste
maxmem= 640
dispusage= fs
multaskopt= 50,100
emsmem= 0,1024
xmsmem= 0,1024
procmemflags= dit, hma
dispoptvideo= txt
dispoptports= hgr
dispflags= emt

[b386]
; allows fast paste / background execution
maxmem= 640
dispusage= fs
execflags= bgd
multaskopt= 50,100
emsmem= 0,1024
xmsmem= 0,1024
procmemflags= dit, hma
dispoptvideo= txt
dispoptports= hgr
dispflags= emt
otheroptions= afp

[npb386]
; does not allow fast paste / background execution
maxmem= 640
dispusage= fs
execflags= bgd
multaskopt= 50,100
emsmem= 0,1024
xmsmem= 0,1024
procmemflags= dit, hma
dispoptvideo= txt
dispoptports= hgr
dispflags= emt

[dflt386sect]
; default is as follows
;
; Other Possible options are given for reference
; ( (or) means entry corresponds to radio button group)
;
maxmem         = 640       ; ##
dispusage      = fs        ; (or) win
execflags      =           ; bgd, exc
multaskopt= 50,100    ; ##,, ## (min, max)
emsmem= 0,1024    ; ##,, ## (min, max)
xmsmem= 0,1024    ; ##,, ## (min, max)
procmemflags= dit, hma  ; eml,, xml, hma, lam
dispoptvideo   = txt       ; (or) lgr, hgr
dispoptports   = hgr       ; txt, lgr
dispflags      = emt       ; rvm
otheroptions   = afp       ; cwa, ata,, aes, ces, psc, aps, asp, aen

[dialog]
    caption= "Setup Applications"

[dontfind]
   calc.exe
   calendar.exe
   cardfile.exe
   clipbrd.exe
   clock.exe
   control.exe
   msdos.exe
   notepad.exe
   packager.exe
   pbrush.exe
   pifedit.exe
   printman.exe
   progman.exe
   recorder.exe
   reversi.exe
   setup.exe
   sol.exe
   spooler.exe
   swapfile.exe
   sysedit.exe
   taskman.exe
   terminal.exe
   winfile.exe
   winhelp.exe
   winver.exe
   write.exe
