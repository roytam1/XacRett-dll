SHAR_EOF
  (set 20 26 10 18 11 26 48 'LICENCE.txt'
   eval "${shar_touch}") && \
  chmod 0755 'LICENCE.txt'
if test $? -ne 0
then ${echo} "restore of LICENCE.txt failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'LICENCE.txt': 'MD5 check failed'
       ) << \SHAR_EOF
3cbefe3885d918c8d00a6f8d7ff1013c  LICENCE.txt
SHAR_EOF

else
test `LC_ALL=C wc -c < 'LICENCE.txt'` -ne 18340 && \
  ${echo} "restoration warning:  size of 'LICENCE.txt' is not 18340"
  fi
fi
if rm -fr ${lock_dir}
then ${echo} "x - removed lock directory ${lock_dir}."
else ${echo} "x - failed to remove lock directory ${lock_dir}."
     exit 1
fi
exit 0
