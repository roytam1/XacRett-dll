$(OBJDIR)\XacRett.res : XacRett.rc
	$(RC) $(RCFLAGS) /fo$@ $**

clean :
	-del /q "$(OBJDIR)\*.obj" 2>nul
	-del /q "$(OBJDIR)\XacRett.res" 2>nul

# Link: provided for when the unrar static lib is ported to VC4.
# Deliberately NOT part of `all`, and WITHOUT shlwapi.lib (VC4 has no
# import library for it; our SHLWAPI use is GetProcAddress-only).
link : $(OBJS) $(OBJDIR)\XacRett.res unrar\UnRAR.lib
	link /nologo /dll /machine:I386 /incremental:no /out:"$(OUTDIR)\XacRett.dll" /def:"XacRett.def" kernel32.lib user32.lib gdi32.lib winspool.lib comdlg32.lib advapi32.lib shell32.lib ole32.lib oleaut32.lib uuid.lib odbc32.lib odbccp32.lib lz32.lib unrar\UnRAR.lib $(OBJS) "$(OBJDIR)\XacRett.res"

