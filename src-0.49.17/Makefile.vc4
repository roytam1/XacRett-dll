# Makefile.vc4 - XacRett.dll VC4 (MSVC 4.x, CL 10.10) build.
#
# Usage (run from this directory, after the MSDEV4 environment):
#   "C:\MSDEV4\BIN\VCVARS32.BAT"
#   nmake -f Makefile.vc4                 (objects + resources)
#   nmake -f Makefile.vc4 OUTDIR=C:\vc4out (redirect outputs)
#   nmake -f Makefile.vc4 clean
#   nmake -f Makefile.vc4 link            (needs unrar\UnRAR.lib; open)
#
# The VC6 build (XacRett.dsp via build.bat/link.bat) is untouched.
# This file only drives the VC4 compatibility path: the in-tree
# vc4compat/ layer (forced via /FI, VC6 never sees it) plus the
# workarea STL/ tree (STLport 2.033, committed alongside).
# See AGENTS.md "MSVC4 compatibility".
# Generated by TEMP/opencode/genmakevc4.py from XacRett.dsp SOURCE lines;
# re-run the generator when sources are added or removed.

!IFNDEF OUTDIR
OUTDIR = $(TEMP)\vc4build
!ENDIF
OBJDIR = $(OUTDIR)\obj

CC = cl
RC = rc

# Base flags mirror genbuild.ps1 (VC6 production flags).
CFLAGS = /nologo /MT /W3 /GX /O2 /c /D WIN32 /D NDEBUG /D _WINDOWS /D _MBCS /D _USRDLL /D XACRETT_EXPORTS /D NO_GZCOMPRESS /I"." /FI"vc4compat\vc4compat.h" /I"..\STL" /I"vc4compat"
CFLAGS_CPP = $(CFLAGS) /I"lhasa"
CFLAGS_UNSQX = $(CFLAGS) /D __SQX_OS_WIN32__
CFLAGS_LHASA = $(CFLAGS) /I"lhasa"
RCFLAGS = /l 0x411 /d NDEBUG

