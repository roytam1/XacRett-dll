# Makefile.win64 - XacRett.dll Win64 build (AMD64 and IA64).
#
# Usage (run from this directory):
#   call C:\AMD64sdk\VCVARS_AMD64.BAT
#   set PATH=C:\AMD64sdk\Bin\Win64-03sp1;%PATH%
#   set LIB=C:\AMD64sdk\Lib\Win64-03sp1;C:\AMD64sdk\Lib\Win64
#   nmake -f Makefile.win64                  (objects, resource, UnRAR.lib, DLL)
#   nmake -f Makefile.win64 OUTDIR=C:\x64out
#   nmake -f Makefile.win64 ARCH=ia64        (the IA64 build)
#   nmake -f Makefile.win64 clean
#
# VCVARS_AMD64.BAT is VCVARS32 + SetWin64.Bat.  The two lines after it are
# MANDATORY: bin\Win64 cannot run (its c1xx.dll wants MSVCP70.dll, which the
# package does not ship) and SetWin64.Bat points LIB at the Beta-1 CRT, whose
# C++ name mangling does not match the 03sp1 compiler (dozens of unresolved
# operator new / _Lockit instead of a real error).  See AGENTS.md, "Win64
# (AMD64) build".
#
# The VC6 (XacRett.dsp via build.bat/link.bat) and VC4 (Makefile.vc4)
# builds are untouched: they never see x64compat/ and their sources are
# the same files, so every Win64 specific change is inside #ifdef _WIN64
# or in a guard that already covered 1200/1000.
#
# Toolchain note: the compiler set shipped in C:\AMD64sdk\bin\Win64 is
# incomplete (its c1xx.dll needs MSVCP70.dll, which is not shipped).
# bin\Win64-03sp1 is complete and reports 14.00.40310.41; put it FIRST
# on the PATH after SetWin64.Bat.
#
# The link line names the 2003 SDK x64 CRT explicitly (libcmt/libcpmt/
# oldnames) because these objects carry no /DEFAULTLIB for it, plus
# bufferoverflowu.lib, which is where that SDK keeps the /GS cookie
# (__security_cookie / __security_check_cookie).  Both are SDK properties
# and not architecture properties, so they live in the variables below:
#
#   SECLIB      the /GS cookie library.  The 2003 SDK keeps it in
#               bufferoverflowu.lib; a compiler without /GS (the VC6 era
#               IA64 edition) does not have it at all.
#   ZCHAR       the wchar_t option.  The 2003 SDK headers assume that
#               wchar_t is an unsigned short, so /Zc:wchar_t- is needed
#               there; VC6 has no such option (it is the default).
#   COMPATFLAG  the include directory with the intrin.h shim.  It is
#               needed by the 2003 SDK, whose CRT has no <intrin.h>, and
#               it is AMD64 only (the shim refuses any other target).
#
# Every one of them can be given on the command line, for a toolset that
# needs something else:
#
#   nmake -f Makefile.win64 ARCH=ia64 SECLIB= ZCHAR= COMPATFLAG=
#
# Generated from XacRett.dsp SOURCE lines + the 49 UnRAR units; re-run
# the generator (TEMP/opencode/genmakewin64.py) when sources change.

!IFNDEF OUTDIR
OUTDIR = $(TEMP)\x64build
!ENDIF
OBJDIR = $(OUTDIR)\obj
UNRAR_OBJDIR = $(OUTDIR)\unrar
UNRARLIB = $(OUTDIR)\UnRAR.lib

!IFNDEF ARCH
ARCH = amd64
!ENDIF

# The SDK specific parts of the build.  The defaults are the ones of the
# 2003 Platform SDK, which is what the AMD64 build uses; an IA64 build
# with another toolset overrides them on the command line.
!IFNDEF SECLIB
!IF "$(ARCH)" == "amd64"
SECLIB = bufferoverflowu.lib
!ELSE
SECLIB =
!ENDIF
!ENDIF

!IFNDEF ZCHAR
!IF "$(ARCH)" == "amd64"
ZCHAR = /Zc:wchar_t-
!ELSE
ZCHAR =
!ENDIF
!ENDIF

!IFNDEF COMPATFLAG
!IF "$(ARCH)" == "amd64"
COMPATFLAG = /I"x64compat"
!ELSE
COMPATFLAG =
!ENDIF
!ENDIF

CC = cl
RC = rc

# Same defines as the VC6 production flags, minus the x86-only bits:
#   /EHsc           instead of /GX (/GX is deprecated from 14.00 on)
#   $(COMPATFLAG)   intrin.h and friends, missing from the 2003 SDK CRT
#
# Shift-JIS literals: 14.00 decodes narrow literals with the BUILD MACHINE
# ANSI code page, so a high-bit byte pair that is invalid in that code page
# (e.g. 81 9B under cp950) becomes "?"; pairs that are valid there round-trip.
# " #pragma setlocale(\"japanese\")" was measured and REJECTED: it decodes the
# source as 932 but still encodes to the machine code page, which mangles
# literals that survive today (93 57 8A 4A came out F8 9A 3F).  Build the
# Win64 target on a Japanese (932) system for byte-exact titles; the affected
# literals are display-only -- 149 of them, all tool titles, the JAK/REZ mode
# markers and two message boxes; nothing compares against them.
#   nullptr=NULL    C++11 keyword the vendored UnRAR still spells
CFLAGS = /nologo /MT /W3 /O2 /c /EHsc /D WIN32 /D NDEBUG /D _WINDOWS /D _MBCS /D _USRDLL /D XACRETT_EXPORTS /D NO_GZCOMPRESS $(COMPATFLAG) /I"." /I"lhasa" $(CEXTRA)
CFLAGS_CPP = $(CFLAGS)
CFLAGS_UNSQX = $(CFLAGS) /I"unsqx" /D __SQX_OS_WIN32__
CFLAGS_LHASA = $(CFLAGS) /I"lhasa"
RCFLAGS = /l 0x411 /d NDEBUG

