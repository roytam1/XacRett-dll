unrar : dirs $(UNRAR_OBJS) $(UNRARLIB)

# 49 object paths overflow the command-line limit, so the list goes
# through a response file.
$(UNRARLIB) : dirs $(UNRAR_OBJS)
	lib /machine:$(ARCH) /out:$@ @<<
  /nologo $(UNRAR_OBJS)
<<

$(OUTDIR)\XacRett.dll : dirs $(OBJS) $(OBJDIR)\XacRett.res $(UNRARLIB)
	link /machine:$(ARCH) /out:"$(OUTDIR)\XacRett.dll" $(LEXTRA) @<<
  /nologo /dll /incremental:no /def:"XacRett.def" $(SECLIB) libcmt.lib libcpmt.lib oldnames.lib kernel32.lib user32.lib gdi32.lib winspool.lib comdlg32.lib advapi32.lib shell32.lib ole32.lib oleaut32.lib uuid.lib odbc32.lib odbccp32.lib $(UNRARLIB) $(OBJS) "$(OBJDIR)\XacRett.res"
<<

link : $(OUTDIR)\XacRett.dll

# The resolved build settings, for a build on another toolset:
#   nmake -f Makefile.win64 vars
# (this target has to be the last one: NMAKE evaluates the macros in file
#  order, so every macro it prints has to be defined above it)
vars :
	@echo ARCH       = $(ARCH)
	@echo SECLIB     = $(SECLIB)
	@echo ZCHAR      = $(ZCHAR)
	@echo COMPATFLAG = $(COMPATFLAG)
	@echo CFLAGS     = $(CFLAGS)
	@echo UNRAR_CFLAGS = $(UNRAR_CFLAGS)
	@echo objects    = 269
