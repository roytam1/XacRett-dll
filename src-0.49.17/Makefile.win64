clean :
	-del /q "$(OBJDIR)\*.obj" 2>nul
	-del /q "$(OBJDIR)\XacRett.res" 2>nul
	-del /q "$(UNRAR_OBJDIR)\*.obj" 2>nul
	-del /q "$(UNRARLIB)" 2>nul

# --- vendored UnRAR (the same 49 units as the VC6 and the VC4 builds) ---
# Do NOT reuse unrar\UnRAR.lib: that one is VC6/x86.  The Win64 library
# is built fresh into $(OUTDIR).  UNICODE/_UNICODE must be on the command
# line because os.hpp includes windows.h before its own defines, and
# $(ZCHAR) keeps the SDK headers (ComDef.h) consistent with the
# rartypes.hpp wchar typedef the VC6 inheritance already has.
UNRAR_CFLAGS = /nologo /MT /W3 /O2 /c /EHsc $(ZCHAR) /D WIN32 /D NDEBUG /D _CONSOLE /D _MBCS /D UNRAR /D RARDLL /D nullptr=NULL /D UNICODE /D _UNICODE $(COMPATFLAG) /I"unrar" /I"unrar\vc6compat" $(CEXTRA)
UNRAR_OBJS = \
	$(UNRAR_OBJDIR)\archive.obj \
	$(UNRAR_OBJDIR)\arcread.obj \
	$(UNRAR_OBJDIR)\blake2s.obj \
	$(UNRAR_OBJDIR)\cmddata.obj \
	$(UNRAR_OBJDIR)\consio.obj \
	$(UNRAR_OBJDIR)\crc.obj \
	$(UNRAR_OBJDIR)\crypt.obj \
	$(UNRAR_OBJDIR)\dll.obj \
	$(UNRAR_OBJDIR)\encname.obj \
	$(UNRAR_OBJDIR)\errhnd.obj \
	$(UNRAR_OBJDIR)\extinfo.obj \
	$(UNRAR_OBJDIR)\extract.obj \
	$(UNRAR_OBJDIR)\filcreat.obj \
	$(UNRAR_OBJDIR)\file.obj \
	$(UNRAR_OBJDIR)\filefn.obj \
	$(UNRAR_OBJDIR)\filestr.obj \
	$(UNRAR_OBJDIR)\find.obj \
	$(UNRAR_OBJDIR)\getbits.obj \
	$(UNRAR_OBJDIR)\global.obj \
	$(UNRAR_OBJDIR)\hash.obj \
	$(UNRAR_OBJDIR)\headers.obj \
	$(UNRAR_OBJDIR)\isnt.obj \
	$(UNRAR_OBJDIR)\largepage.obj \
	$(UNRAR_OBJDIR)\list.obj \
	$(UNRAR_OBJDIR)\match.obj \
	$(UNRAR_OBJDIR)\motw.obj \
	$(UNRAR_OBJDIR)\options.obj \
	$(UNRAR_OBJDIR)\pathfn.obj \
	$(UNRAR_OBJDIR)\qopen.obj \
	$(UNRAR_OBJDIR)\rarvm.obj \
	$(UNRAR_OBJDIR)\rawread.obj \
	$(UNRAR_OBJDIR)\rdwrfn.obj \
	$(UNRAR_OBJDIR)\resource.obj \
	$(UNRAR_OBJDIR)\rijndael.obj \
	$(UNRAR_OBJDIR)\rs16.obj \
	$(UNRAR_OBJDIR)\scantree.obj \
	$(UNRAR_OBJDIR)\secpassword.obj \
	$(UNRAR_OBJDIR)\sha1.obj \
	$(UNRAR_OBJDIR)\sha256.obj \
	$(UNRAR_OBJDIR)\smallfn.obj \
	$(UNRAR_OBJDIR)\strfn.obj \
	$(UNRAR_OBJDIR)\strlist.obj \
	$(UNRAR_OBJDIR)\system.obj \
	$(UNRAR_OBJDIR)\threadpool.obj \
	$(UNRAR_OBJDIR)\timefn.obj \
	$(UNRAR_OBJDIR)\ui.obj \
	$(UNRAR_OBJDIR)\unicode.obj \
	$(UNRAR_OBJDIR)\unpack.obj \
	$(UNRAR_OBJDIR)\volume.obj

$(UNRAR_OBJDIR)\archive.obj : unrar\archive.cpp
	$(CC) $(UNRAR_CFLAGS) /Fo$@ $**

